# Generated by tools/render_cnb.py. Commit this file as kernel_build/.cnb.yml.
$:
  api_trigger_kernel:
    - name: kernel-build
      runner:
        tags: cnb:arch:amd64
        cpus: 64
      docker: &environment
        image: @@BUILDER_IMAGE@@
        volumes:
          - gki-builder:/cache:copy-on-write
      env: &builder
        BUILDER_REPO_URL: @@BUILDER_REPO_URL@@
        BUILDER_REF: @@BUILDER_REF@@
      lock: &kernel_lock
        key: kernel-build
        expires: 43200
        wait: true
        timeout: 43200
      stages:
        - name: 拉取固定版本的构建脚本
          timeout: 10m
          script: &fetch_builder |
            bash -euo pipefail <<'BASH'
            python3 - <<'PY'
            import os, re
            from urllib.parse import urlsplit
            url = urlsplit(os.environ['BUILDER_REPO_URL'])
            if not (url.scheme == 'https' and url.hostname and not url.username and not url.password and not url.query and not url.fragment):
                raise SystemExit('脚本仓库必须使用无凭据的 HTTPS 地址')
            if not re.fullmatch(r'[a-f0-9]{40}|[a-f0-9]{64}', os.environ['BUILDER_REF']):
                raise SystemExit('必须固定脚本仓库完整提交 SHA')
            PY
            test ! -e .kernel-builder
            git init --quiet .kernel-builder
            git -C .kernel-builder remote add origin "$BUILDER_REPO_URL"
            export GIT_TERMINAL_PROMPT=0
            if [[ -n "${BUILDER_GIT_TOKEN:-}" ]]; then
              askpass=$(mktemp)
              trap 'rm -f -- "$askpass"' EXIT
              printf '%s\n' '#!/usr/bin/env bash' 'case "$1" in *Username*) printf "%s\\n" cnb ;; *Password*) printf "%s\\n" "$BUILDER_GIT_TOKEN" ;; esac' > "$askpass"
              chmod 700 "$askpass"
              export GIT_ASKPASS="$askpass"
            fi
            git -c credential.helper= -C .kernel-builder fetch --depth=1 origin "$BUILDER_REF"
            git -C .kernel-builder checkout --quiet --detach FETCH_HEAD
            test "$(git -C .kernel-builder rev-parse HEAD)" = "$BUILDER_REF"
            BASH
        - name: 同步、应用修改并编译内核
          timeout: 8h
          script: bash .kernel-builder/scripts/entrypoint.sh compile
        - name: 重打包并校验 boot.img
          timeout: 1h
          script: bash .kernel-builder/scripts/entrypoint.sh repack
        - name: 发布已校验的 boot.img
          timeout: 1h
          script: bash .kernel-builder/scripts/entrypoint.sh publish-kernel
  api_trigger_prepare:
    - name: source-prepare
      runner:
        tags: cnb:arch:amd64
        cpus: 16
      docker: *environment
      env: *builder
      lock: *kernel_lock
      stages:
        - name: 拉取固定版本的构建脚本
          timeout: 10m
          script: *fetch_builder
        - name: 同步并提取 Makefile
          timeout: 8h
          script: bash .kernel-builder/scripts/entrypoint.sh prepare
        - name: 发布源码预备包
          timeout: 1h
          script: bash .kernel-builder/scripts/entrypoint.sh publish-prepare
